void run_case(string label, int n, int mode) {
ClearVSPModel();
ReadVSPFile("C:/Users/cevin/Documents/Kod/MMS236-Aircraft-design-project/Our_model_plane_V2.vsp3");
array<string>@ ids = FindGeoms();
for(uint i=0;i<ids.size();i++) {
string name=GetGeomName(ids[i]);
bool keep=GetSetFlag(ids[i],1);
if(mode==1) keep=(name=="FuselageA380");
if(mode==2) keep=(name=="FuselageA380" || name=="AilesA380");
if(mode==3) keep=keep && name!="Moteurs internes";
SetSetFlag(ids[i],1,keep);
}
Update();
SetAnalysisInputDefaults("WaveDrag");
array<int> ns(1); ns[0]=n; SetIntAnalysisInput("WaveDrag","NumSlices",ns);
string rid=ExecAnalysis("WaveDrag");
WriteResultsCSVFile(rid,label+".csv");
array<double>@ a=GetDoubleResults(rid,"MaxArea");
Print(label); Print(a[0]);
}
void main(){run_case("full160",160,0);run_case("full320",320,0);run_case("body320",320,1);run_case("bodywing320",320,2);run_case("noengines320",320,3);}
