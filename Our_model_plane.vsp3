      <CustomGeom>
        <Length Value="3.174999999999999822e+00" ID="URLSZFZKWYF"/>
        <Width Value="1.534000000000000030e+00" ID="KKZKQHQPCWF"/>
        <Height Value="1.625999999999999890e+00" ID="ZJESHCRFNGH"/>
        <SquareFlag Value="0.000000000000000000e+00" ID="XNYFXSCNCAL"/>
        <NumRow Value="1.000000000000000000e+01" ID="KIGGMOSGKAV"/>
        <NumCol Value="1.000000000000000000e+00" ID="EMFHTKTDMXY"/>
        <GapRow Value="1.000000000000000238e-03" ID="ZAEUTLOHYAS"/>
        <GapCol Value="1.000000000000000000e+00" ID="BNDABKPLYUJ"/>
